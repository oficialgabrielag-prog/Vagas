# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials (Database & Authentication)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Cloudinary Credentials (Image & Media Uploads)
VITE_CLOUDINARY_CLOUD_NAME="jbj12sj2"
VITE_CLOUDINARY_UPLOAD_PRESET="vagas_emprego_marketplace"

# Google reCAPTCHA v3 Credentials
# VITE_RECAPTCHA_SITE_KEY: Chave pública usada no frontend (Vite) para renderizar e gerar tokens.
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-v3-site-key"
# RECAPTCHA_SECRET_KEY: Chave privada usada EXCLUSIVAMENTE no servidor (Netlify Function / backend).
# NUNCA prefixar com VITE_ para não vazar no bundle do cliente.
RECAPTCHA_SECRET_KEY="your-recaptcha-v3-secret-key"
# Resend Credentials (for email campaigns)
# RESEND_API_KEY: Private key, used EXCLUSIVAMENTE no servidor (Netlify Function).
# NUNCA prefixar com VITE_ para não vazar no bundle do cliente.
RESEND_API_KEY="your-resend-api-key"
